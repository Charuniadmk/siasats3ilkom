    "@prisma/config": { "deepmerge-ts": "^8.0.2" },
    "prisma": { "mysql2": "^3.24.5" }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
